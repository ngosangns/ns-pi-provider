{
  "name": "@ngosangns/ns-pi-provider",
  "version": "0.1.5",
  "description": "Unified Pi coding-agent providers for Kiro, Devin, and Grok \u2014 OAuth/CLI auth, streaming, and auto-updating model catalogs with disk TTL cache.",
  "type": "module",
  "license": "MIT",
  "author": "ngosangns",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngosangns/ns-pi-provider.git"
  },
  "bugs": {
    "url": "https://github.com/ngosangns/ns-pi-provider/issues"
  },
  "homepage": "https://github.com/ngosangns/ns-pi-provider#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "kiro",
    "devin",
    "grok",
    "xai",
    "provider",
    "oauth"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./kiro": "./src/kiro.ts",
    "./devin": "./src/devin.ts",
    "./grok": "./src/grok.ts",
    "./shared": "./src/shared/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "NS_PI_LIVE=1 vitest run tests/live",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
